function filters_type(ftypes) {
  //console.log("FILTER TYPES", ftypes);
  
  var result = [];
  for (var key in filters) {
    // skip loop if the property is from prototype
    if (!filters.hasOwnProperty(key)) continue;
    if ( ftypes.includes(filters[key]['type']) ) {
      filters[key].key = key
      result.push(filters[key]);
    }
  }
  return result;
}
var active_filters = {};

let url = new URL(window.location.protocol+"//"+window.location.hostname+(window.location.port.length !== 0 ? ":"+window.location.port : '')+"/traducciones.csv");
fetch(url.href, {
  method: "GET",
})
.then(r => r.text())
.then(html => {

  let data_obj = Papa.parse(html,{
	delimiter: ",",
  // Auto-detect newline    
  header: true,
  // First row is headers    
  dynamicTyping: true,
  // Automatically convert numbers and booleans    
  skipEmptyLines: true,
  })
  window.data = data_obj.data
  window.total = window.data.length;
  
  //clear filters, render elements and fill filter lists
  clearFilters(false, true);
  //Add filter options
  filters_type(['list']).forEach( filter_list => {
    var serv_options_dom = document.getElementById(filter_list.dom);
    for (var i = 0; i < filter_list.values.length; i++){
      serv_options_dom.innerHTML += '<li class="option '+filter_list.dom+'-option" id="'+filter_list.dom+'-option-'+i+'" onclick="toggleOption(\''+filter_list.key+'\', '+i+', this)">'+filter_list.values[i]+'</li>';
    }
  });
  clearFlag = true
  filters_type(['autocomplete']).forEach( filter_list => {
    //var serv_options_dom = document.getElementById(filter_list.dom);
    let vals = []
    for (var i = 0; i < filter_list.values.length; i++){

      let elems = filter_list.values[i].toString().split("|")
      elems.forEach(ele => {
        if ( !vals.find(o => o.text === ele ) ) {
          vals.push({'text': ele})
        }
        
      });
      //serv_options_dom.innerHTML += '<option value="'+filter_list.values[i]+'" id="'+filter_list.dom+'-option-'+i+'" >'+filter_list.values[i]+'</option>';
    }
    vals.sort((a, b) => a['text'].localeCompare(b['text'], 'es', {'sensitivity': 'accent'}))
    vals.push({text: "No hay datos"})
    let slim = new SlimSelect({
      select: '#'+filter_list.dom,   // this.element is the <select> tag
      showSearch: true,       // show search field
      settings: {
        placeholderText: filter_list.label,
        searchPlaceholder: filter_list.placeholder,
        allowDeselect: true   // allow deselecting (x) option
      },
      data: vals
    })

    autocomplete[filter_list.dom] = slim
  })
  clearFlag = false
})
//window.elements = data;
//FUNCTIONS
function toggleRightFilters() {
  document.getElementById('filters-right').classList.toggle('mobile-hide');
}
//Clear filters and load initial
function clearFilters(flag, initial = false) {
  if (flag) {
    clearFlag = true;
  }
  loading.style.display = "block"
  let i = 0
  for (var key in filters) {
    filters_dom = document.getElementById(filters[key].parent_dom)
    // skip loop if the property is from prototype
    if (!filters.hasOwnProperty(key)) continue;
    //if initial render type
    switch (filters[key].type) {
      case 'list':
        if (initial) {
          let buttonList = '<button aria-expanded="false" class="wrapper select-wrapper" onclick="toggleSearchSelect(\''+filters[key].dom+'\', this)" aria-label="'+filters[key].label+'">'
          buttonList += '<img class="icon" src="/images/'+filters[key].icon+'.svg"/><div id="tit-trigger" class="select-filter">'+filters[key].label+'</div>'
          buttonList += '<ul id="'+filters[key].dom+'" class="select-options"></ul><i class="fas fa-chevron-down right"></i></button>'
          filters_dom.innerHTML = buttonList + filters_dom.innerHTML
        }
        else {
          let options = document.querySelector('#'+filters[key].dom+'-option')
          if (options) {
            for ( const option of options ) {
              option.classList.remove('active');
            }
          }
        }
        break;
      case 'autocomplete':
        if (initial) {
          let slist = '<div class="wrapper"><img class="icon" src="/images/'+filters[key].icon+'.svg"/></i><select onchange="handleAuto(\''+key+'\');" id="'+filters[key].dom+'" multiple></select></div>'
          filters_dom.innerHTML = slist + filters_dom.innerHTML
        }
        else {
          for (let slim of Object.values(autocomplete)) {
            slim.setSelected()
          }
        }
        break;
      case 'boolean':
        if (initial) {
          let checkbox = '<label><input type="checkbox" onchange="handleCheckbox(this, \''+key+'\');" id="'+filters[key].dom+'" value="false"> '+filters[key].label+'</label>'
          filters_dom.innerHTML = checkbox + filters_dom.innerHTML
        }
        else {
          document.getElementById(filters[key].field).checked = false;
        }
        break;
      case 'inbetween':
        Object.keys(filters[key].dom).forEach(dom => {
          if (initial) {
              let input_field = '<div class="wrapper input-wrapper" id="'+dom+'-wrapper"><img class="icon" src="/images/'+filters[key].icon+'.svg"/>'
              input_field += '<input type="text" class="date" id="'+dom+'" name="'+dom+'" placeholder="'+filters[key].dom[dom]+'" onchange="handleInBetween(\''+key+'\',  \''+dom+'\');"></input></div>'
              filters_dom.innerHTML = input_field + filters_dom.innerHTML
          }
          else {
            document.getElementById(dom).value = '';
          }
        });
        break;
      default:
        document.getElementById(filters[key].dom).value = filters[key].default_value;
        break;
    }
    active_filters[key] = filters[key].default_value
  }
  renderElements(window.data, initial)
  clearFlag = false;
}

//Display options
function toggleSearchSelect(elem_id, button) {
  //clear all 
  document.querySelectorAll('.select-wrapper ul:not(#'+elem_id+')').forEach( ul => {
    ul.classList.remove('active')
  });
  document.getElementById(elem_id).classList.toggle('active')
  button.getAttribute('aria-expanded') == "true" ? button.setAttribute('aria-expanded', false) : button.setAttribute('aria-expanded', true)
}

//Add listeners
function handleAuto(key){
  //console.log('CLEARRRRRRR', clearFlag);
  if ( !clearFlag ) {
    active_filters[key] = autocomplete[key].getSelected()
    reloadFilters();
  }
}
function handleCheckbox(checkbox, key){
  if ( !clearFlag ) {
    if( checkbox.checked == true ) {
      active_filters[key] = true;
    }
    else {
      active_filters[key] = false;
    }
      reloadFilters();
  }
}
function handleText(key){
  if ( !clearFlag ) {
    active_filters[key] = document.getElementById(filters[key].dom).value;
    reloadFilters();
  }
}
function handleInBetween(key, field){
  if ( !clearFlag ) {
    active_filters[key][field] = document.getElementById(field).value;
    reloadFilters();
  }
}
//Filter by option
function toggleOption(key, id) {
  var index = active_filters[key].indexOf(id);
  if ( index !== -1 ) {
    active_filters[key].splice(index, 1);
    jQuery('#'+filters[key].dom+'-option-'+id).removeClass("active");
  }
  else {
    active_filters[key].push(id);
    jQuery('#'+filters[key].dom+'-option-'+id).addClass("active");
  }
  //document.getElementById(filters[key].dom).classList.remove('active')
  if ( !clearFlag ) {
    reloadFilters();
  }
}
// show description
function toggleDesc(id) {
  var srv = jQuery('#srv-'+id);
  if ( srv.hasClass('active') ) {
    jQuery('.srv').removeClass('active');
    document.querySelector('#srv-'+id+' .expand').ariaExpanded = false
    document.querySelector('#srv-'+id+' .expand span').textContent = 'Ver más'
  }
  else {
    jQuery('.srv').removeClass('active');
    var position = jQuery('#srv-'+id).offset().top - jQuery('#srv-0').offset().top;
    jQuery("#list").animate({
      scrollTop: position
    }, 500, 'linear' );
    //document.getElementById('srv-'+id).scrollIntoView({behavior: 'smooth'});
    srv.addClass("active");
    document.querySelector('#srv-'+id+' .expand').ariaExpanded = true
    document.querySelector('#srv-'+id+' .expand span').textContent = 'Cerrar'
  }
}

//FILTER
function reloadFilters() {
  result = [];
  loading.style.display = "block"
  window.data.forEach((element, i) => {
    var include = true;
    for ( var key in filters ) {
      switch (filters[key].filter) {
        case 'attribute':
          if ( filters[key].type == 'list' || filters[key].type == 'autocomplete' ) {
            if ( active_filters[key].length > 0 ) {
              let match = false;
              active_filters[key].
              map( x => filters[key].values[x]).
              forEach((item) => {
                if ( element[item] == "TRUE") {
                  match = true;
                  return;
                }
              });
              if ( !match ) {
                include = false;
                return;
              }
            }
          }
          else {
            if ( active_filters[key] ) {
              if ( element[filters[key].field] != "TRUE" ) {
                include = false;
                return;
              }
            }
          }
          break;
        case 'include':
          if ( active_filters[key].length > 0 ) {
            include = false
            let vals = element[filters[key].field].toString().split('|')
            console.log(vals);
            
            vals.forEach(ele => {
              ele.trim()
              if ( active_filters[key].includes(ele) ) {
                include = true;
              }
            });
          }
          break;
        case 'between':
          if ( active_filters[key] >= 0 ) {
            if ( element[filters[key].field[0]] > active_filters[key] || active_filters[key] > element[filters[key].field[1]] ) {
              include = false;
              return;
            }
          }
          break;
        case 'inbetween':
          let doms = Object.keys(filters[key].dom)
          if ( active_filters[key][doms[0]] > 0 && active_filters[key][doms[0]] != '' ) {
            if ( element[filters[key].field] > active_filters[key][doms[0]] ) {
              include = false;
              return;
            }
          }
          if ( active_filters[key][doms[1]] > 0 && active_filters[key][doms[1]] != '' ) {
            if ( active_filters[key][doms[1]] > element[filters[key].field] ) {
              include = false;
              return;
            }
          }
          break;
        case 'search':
          if ( active_filters[key] != '' ) {
            include = false;
            let str = Object.values(element).join(" ").toLowerCase()
            active_filters[key].toLowerCase().split(' ').forEach(word => {
              if ( str.search(word) !== -1 ) {
                include = true;
                return;
              }
            });
          }
        default:
          break;
      }
    }
    if (include) {
      //reload lists
      result.push(element);
    }
  });
 render_filter_tags();
 renderElements(result, true);
 //setAutocompleteLists();
}

function setAutocompleteLists() {
  clearFlag = true;
  for (let field of Object.keys(autocomplete)) {
    let filist = []
    console.log("AUTOCOMPLETE DE ", field);
    filters[field].values.forEach(x => {
      filist.push({'text': x, 'value': x })
    });
    console.log("FILIST DE ", filist);
    autocomplete[field].setData(filist)
  }
  clearFlag = false;
}
function render_filter_tags() {
  document.getElementById("filter-tags").innerHTML = ''
  for (let key in active_filters) {
    switch (filters[key].filter) {
      case 'attribute':
      case 'include':
        if ( filters[key].type != 'autocomplete' ) {
          if ( filters[key].type == 'list' ) {
            if ( active_filters[key].length > 0 ) {
              for(let afPos in active_filters[key]) {
                let pos = active_filters[key][afPos]
                add_search_tag(filters[key].values[pos], key, pos)
              }
            }
          }
          else {
            if ( active_filters[key] ) {
              add_search_tag(filters[key].label, key, -1)
            }
          }
        }
        break;
      case 'between':
        if ( active_filters[key] >= 0 ) {
          add_search_tag(filters[key].label+': '+active_filters[key], key, -1)
        }
        break;
      case 'inbetween':
        let doms = Object.keys(filters[key].dom)
        if ( active_filters[key][doms[0]] > 0 ) {
          add_search_tag(filters[key].dom[doms[0]]+': '+active_filters[key][doms[0]], key, doms[0])
        }
        if (active_filters[key][doms[1]] > 0 ) {
          add_search_tag(filters[key].dom[doms[1]]+': '+active_filters[key][doms[1]], key, doms[1])
        }
        break;
      case 'search':
        if ( active_filters[key] != '' ) {
          add_search_tag('Búsqueda: '+active_filters[key], key, -1)
        }
      default:
        break;
    }
  }
}
function add_search_tag(label, key, pos) {
  let tag = '<div class="tag"><span>'+label+'</span><button onclick="remove_search_tag(\''+key+'\', \''+pos+'\')">X</button>' 
  document.getElementById("filter-tags").innerHTML += tag
}

function remove_search_tag(key, pos) {
  if ( isNaN(pos) ) {
    active_filters[key][pos] = ''//filters[key].default_value
  }
  else {
    if ( pos != -1 ) {
      let arr_pos = active_filters[key].indexOf(parseInt(pos))
      if ( arr_pos !== -1 ) {
        active_filters[key].splice(arr_pos, 1)
      }
    }
    else {
      active_filters[key] = filters[key].default_value
    }
  }
  switch (filters[key].filter) {
    case 'attribute':
    case 'include':
      if ( filters[key].type == 'list' ) {
        document.getElementById(filters[key].dom+'-option-'+pos).classList.remove("active");
      }
      else {
        if ( filters[key].type == 'autocomplete' )
        document.getElementById(filters[key].dom).value = filters[key].default_value
      }
      break;
    case 'inbetween':
      document.getElementById(pos).value = ''//filters[key].default_value
      break;
    default:
      document.getElementById(filters[key].dom).value = filters[key].default_value
      break
  }
  reloadFilters()
}
