var clearFlag = false;
var currentList = [];
var autocomplete = {};
const filters = {
  'year': {"type": 'inbetween', "default_value": {}, "field": 'Año de publicacion', "dom": {"year_min": "Período desde", 'year_max': "Hasta"}, "icon": "calendar", "filter": "inbetween", 'parent_dom': "filters-right-2"},
  'city': {"type": 'autocomplete', "default_value": [], "field":'Ciudad de publicación', "dom": 'city', "values": [], "label": 'Ciudad', "icon": "location", "filter": "include", 'parent_dom': "filters-right-1"},
  'ente': {"type": 'autocomplete', "default_value": [], "field":'Ente editor', "dom": 'ente', "values": [], "label": 'Ente editor', "icon": "building", "filter": "include", 'parent_dom': "filters-right-1"},
  'lengua': {"type": 'autocomplete', "default_value": [], "field":'Lengua fuente', "dom": 'lengua', "values": [], "label": 'Lengua fuente', "icon": "lengua", "filter": "include", 'parent_dom': "filters-right-1"},
  'trans': {"type": 'autocomplete', "default_value": [], "field": "Traductor/a", "dom": "tans", "values": [], "label": "Traductor/a", "icon": "person", "filter": "include", 'parent_dom': "filters-right-1"},
  'tit': {"type": 'autocomplete', "default_value": [], "field": 'titulo', "dom": 'titulo', "values": [], "label": "Título", "icon": "title", "filter": "include", 'parent_dom': "filters-right-1"},
  'aut': {"type": 'autocomplete', "default_value": [], "field":'aut_principal', "dom": 'aut', "values": [], "label": "Autor/a", "icon": "book-person", "filter": "include", "placeholder": "Autor/a", 'parent_dom': "filters-right-1"},
  'search_res': {"type": 'text', "default_value": '', "field":[], "dom": 'search-res', "label": "Buscar por autor/a, traductor/a, título, ISBN, VIAF u otros términos", "icon": "magnifying-glass", "filter": "search", 'parent_dom': "filters-left" },
}
function filters_type(ftypes) {
  //console.log("FILTER TYPES", ftypes);
  
  var result = [];
  for (var key in filters) {
    // skip loop if the property is from prototype
    if (!filters.hasOwnProperty(key)) continue;
    if ( ftypes.includes(filters[key]['type']) ) {
      filters[key].key = key
      result.push(filters[key]);
    }
  }
  return result;
}
var active_filters = {};

let url = new URL(window.location.protocol+"//"+window.location.hostname+(window.location.port.length !== 0 ? ":"+window.location.port : '')+"/traducciones.csv");
fetch(url.href, {
  method: "GET",
})
.then(r => r.text())
.then(html => {

  let data_obj = Papa.parse(html,{
	delimiter: ",",
  // Auto-detect newline    
  header: true,
  // First row is headers    
  dynamicTyping: true,
  // Automatically convert numbers and booleans    
  skipEmptyLines: true,
  })
  window.data = data_obj.data
  window.total = window.data.length;
  
  //clear filters, render elements and fill filter lists
  clearFilters(false, true);
  //Add filter options
  filters_type(['list']).forEach( filter_list => {
    var serv_options_dom = document.getElementById(filter_list.dom);
    for (var i = 0; i < filter_list.values.length; i++){
      serv_options_dom.innerHTML += '<li class="option '+filter_list.dom+'-option" id="'+filter_list.dom+'-option-'+i+'" onclick="toggleOption(\''+filter_list.key+'\', '+i+', this)">'+filter_list.values[i]+'</li>';
    }
  });
  filters_type(['autocomplete']).forEach( filter_list => {
    var serv_options_dom = document.getElementById(filter_list.dom);
    for (var i = 0; i < filter_list.values.length; i++){
      serv_options_dom.innerHTML += '<option value="'+filter_list.values[i]+'" id="'+filter_list.dom+'-option-'+i+'" >'+filter_list.values[i]+'</option>';
    }
    console.log("CREATE SLIM", );
    
    let slim = new SlimSelect({
      select: '#'+filter_list.dom,   // this.element is the <select> tag
      showSearch: true,       // show search field
      settings: {
        placeholderText: filter_list.label,
        searchPlaceholder: filter_list.placeholder,
        allowDeselect: true   // allow deselecting (x) option
      }
    })

    autocomplete[filter_list.dom] = slim
  })
})
//window.elements = data;
//FUNCTIONS
//Clear filters and load initial
function clearFilters(flag, initial = false) {
  if (flag) {
    clearFlag = true;
  }
  let i = 0
  for (var key in filters) {
    console.log("FILTER: ", filters[key])
    filters_dom = document.getElementById(filters[key].parent_dom)
    // skip loop if the property is from prototype
    if (!filters.hasOwnProperty(key)) continue;
    //if initial render type
    switch (filters[key].type) {
      case 'list':
        if (initial) {
          let buttonList = '<button aria-expanded="false" class="wrapper select-wrapper" onclick="toggleSearchSelect(\''+filters[key].dom+'\', this)" aria-label="'+filters[key].label+'">'
          buttonList += '<img class="icon" src="/images/'+filters[key].icon+'.svg"/><div id="tit-trigger" class="select-filter">'+filters[key].label+'</div>'
          buttonList += '<ul id="'+filters[key].dom+'" class="select-options"></ul><i class="fas fa-chevron-down right"></i></button>'
          filters_dom.innerHTML = buttonList + filters_dom.innerHTML
        }
        else {
          let options = document.querySelector('#'+filters[key].dom+'-option')
          if (options) {
            for ( const option of options ) {
              option.classList.remove('active');
            }
          }
        }
        break;
      case 'autocomplete':
        if (initial) {
          let slist = '<div class="wrapper"><img class="icon" src="/images/'+filters[key].icon+'.svg"/></i><select onchange="handleAuto(\''+key+'\');" id="'+filters[key].dom+'" multiple></select></div>'
          filters_dom.innerHTML = slist + filters_dom.innerHTML
        }
        else {
          for (let slim of Object.values(autocomplete)) {
            slim.setSelected()
          }
        }
        break;
      case 'boolean':
        if (initial) {
          let checkbox = '<label><input type="checkbox" onchange="handleCheckbox(this, \''+key+'\');" id="'+filters[key].dom+'" value="false"> '+filters[key].label+'</label>'
          filters_dom.innerHTML = checkbox + filters_dom.innerHTML
        }
        else {
          document.getElementById(filters[key].field).checked = false;
        }
        break;
      case 'inbetween':
        Object.keys(filters[key].dom).forEach(dom => {
          if (initial) {
              let input_field = '<div class="wrapper input-wrapper" id="'+dom+'-wrapper">'
              input_field += '<input type="date" id="'+dom+'" name="'+dom+'" placeholder="'+filters[key].dom[dom]+'" onchange="handleInBetween(this, \''+key+'\',  \''+dom+'\');"></input></div>'
              filters_dom.innerHTML = input_field + filters_dom.innerHTML
          }
          else {
            document.getElementById(dom).value = filters[key].default_value;
          }
        });
        break;
      default:
        if (initial) {
          let input_field = '<div class="wrapper input-wrapper" id="'+filters[key].dom+'-wrapper"><img class="icon" src="/images/'+filters[key].icon+'.svg"/>'
          input_field += '<input type="text" id="'+filters[key].dom+'" name="'+filters[key].dom+'" placeholder="'+filters[key].label+'" onkeyup="handleText(this, \''+key+'\');"></input></div>'
          filters_dom.innerHTML = input_field + filters_dom.innerHTML
        }
        else {
          document.getElementById(filters[key].dom).value = filters[key].default_value;
        }
        break;
    }
    active_filters[key] = filters[key].default_value
  }
  renderElements(window.data, initial)
  clearFlag = false;
}

//Display options
function toggleSearchSelect(elem_id, button) {
  //clear all 
  document.querySelectorAll('.select-wrapper ul:not(#'+elem_id+')').forEach( ul => {
    ul.classList.remove('active')
  });
  document.getElementById(elem_id).classList.toggle('active')
  button.getAttribute('aria-expanded') == "true" ? button.setAttribute('aria-expanded', false) : button.setAttribute('aria-expanded', true)
}

//Add listeners
function handleAuto(key){
  if ( !clearFlag ) {
    let options = document.getElementById(filters[key].dom).options; 
    res = []
    console.log("AUTO", key);
    i = 0
    for (let option of options ) {
      if ( option.selected ) {
        console.log("ALGO", option);
        res.push(i)
      }
      i++
    }
    active_filters[key] = res
    reloadFilters();
  }
}
function handleCheckbox(checkbox, key){
  if ( !clearFlag ) {
    if( checkbox.checked == true ) {
      active_filters[key] = true;
    }
    else {
      active_filters[key] = false;
    }
      reloadFilters();
  }
}
function handleText(input, key){
  if ( !clearFlag ) {
    active_filters[key] = jQuery('#'+filters[key].dom).val();
    reloadFilters();
  }
}
function handleInBetween(input, key, field){
  console.log("INBETWEEN",field);
  
  if ( !clearFlag ) {
    active_filters[key][field] = jQuery('#'+field).val();
    reloadFilters();
  }
}
//Filter by option
function toggleOption(key, id) {
  var index = active_filters[key].indexOf(id);
  if ( index !== -1 ) {
    active_filters[key].splice(index, 1);
    jQuery('#'+filters[key].dom+'-option-'+id).removeClass("active");
  }
  else {
    active_filters[key].push(id);
    jQuery('#'+filters[key].dom+'-option-'+id).addClass("active");
  }
  //document.getElementById(filters[key].dom).classList.remove('active')
  if ( !clearFlag ) {
    reloadFilters();
  }
}
// show description
function toggleDesc(id) {
  var srv = jQuery('#srv-'+id);
  jQuery('.srv').removeClass('active');
  if ( srv.hasClass('active') ) {
    document.querySelector('#srv-'+id+' .expand').ariaExpanded = false
    document.querySelector('#srv-'+id+' .expand span').textContent = 'Ver más'
  }
  else {
    var position = jQuery('#srv-'+id).offset().top - jQuery('#srv-0').offset().top;
    jQuery("#list").animate({
      scrollTop: position
    }, 1000, 'linear' );
    //document.getElementById('srv-'+id).scrollIntoView({behavior: 'smooth'});
    srv.addClass("active");
    document.querySelector('#srv-'+id+' .expand').ariaExpanded = true
    document.querySelector('#srv-'+id+' .expand span').textContent = 'Cerrar'
    //map.flyTo( [currentList[id].lat, currentList[id].lng], 18);
  }
}

//FILTER
function reloadFilters() {
  result = [];
  console.log("RELOAD", active_filters);
  
  window.data.forEach((element, i) => {
    var include = true;
    for ( var key in filters ) {
      switch (filters[key].filter) {
        case 'attribute':
          if ( filters[key].type == 'list' || filters[key].type == 'autocomplete' ) {
            if ( active_filters[key].length > 0 ) {
              let match = false;
              active_filters[key].
              map( x => filters[key].values[x]).
              forEach((item) => {
                if ( element[item] == "TRUE") {
                  match = true;
                  return;
                }
              });
              if ( !match ) {
                include = false;
                return;
              }
            }
          }
          else {
            if ( active_filters[key] ) {
              if ( element[filters[key].field] != "TRUE" ) {
                include = false;
                return;
              }
            }
          }
          break;
        case 'include':
          if ( active_filters[key].length > 0 ) {
            if ( !active_filters[key].map( x => filters[key].values[x]).includes(element[filters[key].field]) ) {
              include = false;
              return;
            }
          }
          break;
        case 'between':
          if ( active_filters[key] >= 0 ) {
            if ( element[filters[key].field[0]] > active_filters[key] || active_filters[key] > element[filters[key].field[1]] ) {
              include = false;
              return;
            }
          }
          break;
        case 'inbetween':
          if ( active_filters[key] >= 0 ) {
            if ( element[filters[key].field] > active_filters[key][filters[key].dom[0]] || active_filters[key][filters[key].dom[1]] > element[filters[key].field] ) {
              include = false;
              return;
            }
          }
          break;
        case 'search':
          if ( active_filters[key] != '' ) {
            if ( Object.values(element).join(" ").toLowerCase().search(active_filters[key].toLowerCase()) === -1 ) {
              include = false;
              return;
            }
          }
        default:
          break;
      }
    }
    if (include) {
      result.push(element);
    }
  });
 render_filter_tags();
 renderElements(result);
}

function render_filter_tags() {
  document.getElementById("filter-tags").innerHTML = ''
  for (let key in active_filters) {
    switch (filters[key].filter) {
      case 'attribute':
      case 'include':
        if ( filters[key].type != 'autocomplete' ) {
          if ( filters[key].type == 'list' ) {
            if ( active_filters[key].length > 0 ) {
              for(let afPos in active_filters[key]) {
                let pos = active_filters[key][afPos]
                add_search_tag(filters[key].values[pos], key, pos)
              }
            }
          }
          else {
            if ( active_filters[key] ) {
              add_search_tag(filters[key].label, key, -1)
            }
          }
        }
        break;
      case 'between':
        if ( active_filters[key] >= 0 ) {
          add_search_tag(filters[key].label+': '+active_filters[key], key, -1)
        }
        break;
      case 'search':
        if ( active_filters[key] != '' ) {
          add_search_tag('Búsqueda: '+active_filters[key], key, -1)
        }
      default:
        break;
    }
  }
}
function add_search_tag(label, key, pos) {
  let tag = '<div class="tag"><span>'+label+'</span><button onclick="remove_search_tag(this, \''+key+'\', \''+pos+'\')">X</button>' 
  document.getElementById("filter-tags").innerHTML += tag
}

function remove_search_tag(elem, key, pos) {
  if ( pos != -1 ) {
    let arr_pos = active_filters[key].indexOf(parseInt(pos))
    if ( arr_pos !== -1 ) {
      active_filters[key].splice(arr_pos, 1)
    }
  }
  else {
    active_filters[key] = filters[key].default_value
  }
  switch (filters[key].filter) {
    case 'attribute':
      case 'include':
        if ( filters[key].type == 'list' ) {
          document.getElementById(filters[key].dom+'-option-'+pos).classList.remove("active");
        }
        else {
          if ( filters[key].type == 'autocomplete' )
          document.getElementById(filters[key].dom).value = filters[key].default_value
        }
        break;
    default:
      document.getElementById(filters[key].dom).value = filters[key].default_value
      break
  }
  reloadFilters()
}
//Single element html
function elementListHtml(element, i) {
  const style = get_style(element.poblacion);
  return '<li onclick="toggleDesc('+ i +')" class="srv" id="srv-'+ i +'">\
      <div class="srv-header">\
        <div class="title">\
          <h2>'+element.titulo+'</h2><h3><a onclick="filter(\'aut\', \''+element.aut_principal+'\')">'+element.aut_principal+'</a></h3>\
        </div>\
        <div class="title-left">\
          <button class="print"><img style="color: '+style.color+'" src="/images/print.svg"></img><span>Imprimir</span></button>\
          <button class="expand" aria-controls="srv-'+ i +'" aria-expanded="false"><span>Ver más</span><i style="color: '+style.color+'" class="fas fa-'+style.icon+'"></i></button>\
        </div>\
      </div>\
      <div class="srv-body">\
        <div class="row"><i class="fas fa-language"></i><span>Lengua fuente: </span><a class="tag" onclick="filter(\'lengua\', \''+element["Lengua fuente"]+'\')"><i class="fas fa-magnifying-glass"></i>'+element["Lengua fuente"]+'</a></div>\
        <div class="row"><i class="fas fa-building"></i><span>Ente editor: </span>\
          <a class="tag" onclick="filter(\'ente\', \''+element["Ente editor"]+'\')"><i class="fas fa-magnifying-glass"></i>'+element["Ente editor"]+'</a>\
          <a class="tag" onclick="filter(\'city\', \''+element["Ciudad de publicación"]+'\')"><i class="fas fa-magnifying-glass"></i>'+element["Ciudad de publicación"]+'</a></div>\
        <div class="row"><i class="fas fa-calendar"></i><span>Año de publicación: </span>'+element["Año de publicación"]+'</div>\
        <div class="row"><i class="fas fa-user"></i><span>Traductor/a: </span><a class="tag" onclick="filter(\'city\', \''+element["Traductor/a"]+'\')"><i class="fas fa-magnifying-glass"></i>'+element["Traductor/a"]+'</a></div>\
        <div class="row"><i class="fas fa-comment"></i><span>Observaciones: </span>'+element.Observaciones+'</div>\
  </li>';
}
function filter(field, fvalue) {
  switch (filters[field].type) {
    case 'list':
      break;
    case 'autocomplete':
      console.log("FILTER AUTOCOMPLETE", fvalue);
      autocomplete[field].setSelected(fvalue)
      break;
    case 'boolean':
      break;
    case 'inbetween':
      break;
    default:
      break;
  }
}
 function get_style(element) {
   var res = {color: '#0F57FB', icon: 'chevron-right'};
    return res;
 }
 function renderElements(elements, initial = false) {
   //Generate markers for all data rows |element = data[0]
   if ( elements.length > 0 ) {
     jQuery('#no-results').hide();
     currentList = elements;
     var list = '<ul>';
     elements.forEach((element, i) => {
       list += elementListHtml(element, i);
       //Load filters lists if initial load
       if ( initial ) {
        filters_type(['list', 'autocomplete']).forEach( filter_list => {
          if ( !filter_list.values.includes(element[filter_list.field]) ) {
            filter_list.values.push(element[filter_list.field]);
          }
        });
       }
     });
     list += '</ul>';
     document.getElementById("list").innerHTML = list;
     document.getElementById("results").innerHTML = "Mostrando "+elements.length+"/"+window.total+" autores";
   }
   else {
     jQuery('#no-results').show();
   }
 }
</script>
