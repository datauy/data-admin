  'year': {"type": 'inbetween', "default_value": {}, "field": 'Año de publicación', "dom": {'year_max': "Hasta", "year_min": "Período desde"}, "icon": "calendar", "filter": "inbetween", 'parent_dom': "filters-right-2"},
