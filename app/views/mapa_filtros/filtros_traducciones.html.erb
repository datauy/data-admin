<div id="filters">
  <div id="filters-right">
    <div id="filters-right-1"></div>
    <div id="filters-right-2"></div>
  </div>
  <div id="filters-left">
    <div class="wrapper">
      <div id="results" class="button"></div>
      <button aria-label="Borrar filtros" onclick="clearFilters(true)" class="wrapper main-button large">
        <i class="fas fa-filter-circle-xmark"></i>
        <span>Borrar filtros</span>
      </button>
      <button aria-label="Filtros" onclick="showFilters(true)" class="wrapper button small">
        <i class="fas fa-filter-circle"></i>
        <span>Filtros</span>
      </button>
    </div>
    <div id="filter-tags"></div>
  </div>
</div>
<div id="mapa-section">
  <div id="list"></div>
  <div id="no-results" style="display:none;">
    <span>No hay resultados para los filtros seleccionados</span>
    <i onclick="document.getElementById('no-results').style.display = 'none';" class="fa fa-close"></i>
  </div>
</div>
