function filter(field, fvalue) {
  clearFilters(true)
  switch (filters[field].type) {
    case 'list':
      break;
    case 'autocomplete':
      console.log("FILTER AUTOCOMPLETE", fvalue);
      autocomplete[field].setSelected(fvalue)
      break;
    case 'boolean':
      break;
    case 'inbetween':
      break;
    default:
      break;
  }
}
  function get_style(element) {
    var res = {color: '#0F57FB', icon: 'chevron-right'};
    return res;
  }
  function renderElements(elements, initial = false) {
   //Generate markers for all data rows |element = data[0]
   console.log("RENDER", elements.length);
   
   if ( elements.length > 0 ) {
      noresults.style.display = 'none'
      currentList = elements;
      var list = '<ul>';
      let filter_lists = filters_type(['list', 'autocomplete'])
      //filters_type(['list', 'autocomplete']).forEach( filter_list => {
      //  filter_list.values = []
      //});
      elements.sort((a, b) => a['Año de publicación'] - b['Año de publicación']).forEach((element, i) => {
        list += elementListHtml(element, i);
        //Load filters lists if initial load
        if ( initial ) {
        filter_lists.forEach( filter_list => {
          if ( !filter_list.values.includes(element[filter_list.field]) ) {
            filter_list.values.push(element[filter_list.field]);
          }
        });
        }
      });
      list += '</ul>';
      document.getElementById("list").innerHTML = list;
      document.getElementById("results").innerHTML = "Mostrando "+elements.length+"/"+window.total+" entradas";
    }
    else {
      document.getElementById("list").innerHTML = '';
      document.getElementById("results").innerHTML = "Mostrando "+elements.length+"/"+window.total+" entradas";
      noresults.style.display = 'flex'
    }
    loading.style.display = "none"
  }
  function printDiv(id, title) {
    
    var divToPrint=document.getElementById(id);

    var newWin=window.open();
    newWin.document.open();
    newWin.document.write('<html><head><style>button{display:none;}</style><title>'+title+'</title></head><body>'+divToPrint.innerHTML+'</body></html>');
    newWin.document.close();
    newWin.focus();
    newWin.print();
    newWin.close();
    setTimeout(function(){newWin.close();},10);
  }
  function exportSearch() {
    let result = Object.keys(currentList[0]).join(',')+'\n'
    currentList.forEach(line => {
      console.log(line);
      result += '"'+Object.values(line).join('","')+'"\n'
    });
    const blob = new Blob([result], { type: 'text/csv;charset=utf-8,' })
    const objUrl = URL.createObjectURL(blob)
    var newWin=window.open(objUrl);
    //setTimeout(function(){newWin.close();},10);
  }
</script>
