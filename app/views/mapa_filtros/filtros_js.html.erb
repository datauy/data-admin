<div class="backdrop"></div>
<div id="mapa-section">
  <div id="map-wrapper">
    <div id="filters">    
        <button aria-expanded="false" aria-label="Borrar filtros" onclick="clearFilters()" class="wrapper">
          <i class="fas fa-filter-circle-xmark"></i>
          <span>Borrar filtros</span>
        </button>
      <div id="results" class="button"></div>
    </div>
    <div id="map" style="height: 500px;"></div>
    <div id="no-results" style="display:none;">
      <span>No hay resultados para los filtros seleccionados</span>
      <i onclick="jQuery('#no-results').hide();" class="fa fa-close"></i>
    </div>
  </div>
  <div id="list"></div>
</div>
<script>
//Obtain data from the json file
