const mapBounds = [];
var currentList = [];
var min_max_age = [];
const filters = {
  'search_res': {"type": 'text', "default_value": '', "field":[], "dom": 'search-res', "label": "Buscar...", "icon": "magnifying-glass", "filter": "search" },
  'ext': {"type": 'boolean', "default_value": false, "field":'extendido', "dom": 'extendido', "label": 'Horario extendido', "filter": "attribute"},
  'summ': {"type": 'boolean', "default_value": false, "field":'verano', "dom": 'verano', "label": 'Funciona en verano', "filter": "attribute"},
  'age': {"type": 'integer', "default_value": "-1", "field": ['edad_mínima', 'edad_máxima'], "dom": "edad", "label": "Edad", "icon": "cake", "filter": "between"},
  'obj': {"type": 'list', "default_value": [], "field": 'poblacion', "dom": 'objetivo', "values": [], "label": "Población objetivo", "icon": "building", "filter": "attribute"},
  'serv': {"type": 'list', "default_value": [], "field":'tipo_centro', "dom": 'servicio', "values": [], "label": "Tipo de servicio", "icon": "building", "filter": "include"},
}
function filters_type($type) {
  var result = [];
  for (var key in filters) {
    // skip loop if the property is from prototype
    if (!filters.hasOwnProperty(key)) continue;
    if ( filters[key]['type'] == $type ) {
      filters[key].key = key
      result.push(filters[key]);
    }
  }
  return result;
}
var active_filters = {};

let url = new URL(window.location.protocol+"//"+window.location.hostname+(window.location.port.length !== 0 ? ":"+window.location.port : '')+"/markers.json");
fetch(url.href, {
  method: "GET",
})
.then(r => r.text())
.then(html => {
  console.log("GETTING DATA: ", html);
  window.data = JSON.parse(html)
  //clear filters, render elements and fill filter lists
  clearFilters(true);
  window.total = data.length;
  //Add filters
  filters_type('list').forEach( filter_list => {
    var serv_options_dom = document.getElementById(filter_list.dom);
    for (var i = 0; i < filter_list.values.length; i++){
      serv_options_dom.innerHTML += '<li class="option '+filter_list.dom+'-option" id="'+filter_list.dom+'-option-'+i+'" onclick="toggleOption(\''+filter_list.key+'\', '+i+', this)">'+filter_list.values[i]+'</li>';
    }
  });
})
//window.elements = data;

//MAP
var markers = L.layerGroup();
var map = L.map('map', {scrollWheelZoom: false}).setView([-34.897013, -56.171186], 13);
L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {
  maxZoom: 19,
   subdomains: 'abcd',
   attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors &copy; <a href="https://carto.com/attributions">CARTO</a>'
}).addTo(map);
map.zoomControl.setPosition('topright');

//FUNCTIONS
//Clear filters and load initial
function clearFilters(initial = false) {
  filters_dom = document.getElementById("filters")
  for (var key in filters) {
    // skip loop if the property is from prototype
    if (!filters.hasOwnProperty(key)) continue;
    //if initial render type
    switch (filters[key].type) {
      case 'list':
        if (initial) {
          let buttonList = '<button aria-expanded="false" class="wrapper select-wrapper" onclick="toggleSearchSelect(\''+filters[key].dom+'\', this)" aria-label="'+filters[key].label+'">'
          buttonList += '<div id="objetivo-trigger" class="select-filter"><img class="icon" src="/images/'+filters[key].icon+'.svg"/>'+filters[key].label+'</div>'
          buttonList += '<ul id="'+filters[key].dom+'" class="select-options"></ul><i class="fas fa-chevron-down right"></i></button>'
          filters_dom.innerHTML = buttonList + filters_dom.innerHTML
        }
        else {
          let options = document.querySelector('#'+filters[key].dom+'-option')
          if (options) {
            for ( const option of options ) {
              option.classList.remove('active');
            }
          }
        }
        break;
      case 'boolean':
        if (initial) {
          let checkbox = '<label><input type="checkbox" onchange="handleCheckbox(this, \''+key+'\');" id="'+filters[key].dom+'" value="false"> '+filters[key].label+'</label>'
          filters_dom.innerHTML = checkbox + filters_dom.innerHTML
        }
        else {
          document.getElementById(filters[key].field).checked = false;
        }
        break;
      default:
        if (initial) {
          let input_field = '<div id="'+filters[key].dom+'-wrapper"><img class="icon" src="/images/'+filters[key].icon+'.svg"/>'
          input_field += '<input type="text" id="'+filters[key].dom+'" name="'+filters[key].dom+'" placeholder="'+filters[key].label+'" onkeyup="handleText(this, \''+key+'\');"></input></div>'
          filters_dom.innerHTML = input_field + filters_dom.innerHTML
        }
        else {
          document.getElementById(filters[key].dom).value = filters[key].default_value;
        }
        break;
    }
    active_filters[key] = filters[key].default_value
  }
  renderElements(window.data, initial)
}

//Display options
function toggleSearchSelect(elem_id, button) {
  //clear all 
  document.querySelectorAll('.select-wrapper ul:not(#'+elem_id+')').forEach( ul => {
    ul.classList.remove('active')
  });
  document.getElementById(elem_id).classList.toggle('active')
  button.getAttribute('aria-expanded') == "true" ? button.setAttribute('aria-expanded', false) : button.setAttribute('aria-expanded', true)
}

//Add listeners
function handleCheckbox(checkbox, key){
  if( checkbox.checked == true ) {
    active_filters[key] = true;
  }
  else {
    active_filters[key] = false;
  }
  reloadFilters();
}
function handleText(input, key){
  active_filters[key] = jQuery('#'+filters[key].dom).val();
  reloadFilters();
}
//Filter by option
function toggleOption(key, id) {
  console.log("TOGGLE OPTION", document.getElementById(filters[key].dom));
  
  var index = active_filters[key].indexOf(id);
  if ( index !== -1 ) {
    active_filters[key].splice(index, 1);
    jQuery('#'+filters[key].dom+'-option-'+id).removeClass("active");
  }
  else {
    active_filters[key].push(id);
    jQuery('#'+filters[key].dom+'-option-'+id).addClass("active");
  }
  //document.getElementById(filters[key].dom).classList.remove('active')
  reloadFilters();
}
// show description
function toggleDesc(id) {
 var srv = jQuery('#srv-'+id);
 if ( srv.hasClass('active') ) {
   jQuery('.srv').removeClass('active');
 }
 else {
   jQuery('.srv').removeClass('active');
   var position = jQuery('#srv-'+id).offset().top - jQuery('#srv-0').offset().top;
   jQuery("#list").animate({
     scrollTop: position
   }, 1000, 'linear' );
   //document.getElementById('srv-'+id).scrollIntoView({behavior: 'smooth'});
   srv.addClass("active");
   map.flyTo( [currentList[id].lat, currentList[id].lng], 18);
 }
}
// Click PIN
function clickPin(pin) {
 let pos = pin.target.options.list_pos;
 toggleDesc(pos);
}

//FILTER
function reloadFilters() {
  console.log("RELOAD FILTERS", active_filters);
  result = [];
  window.data.forEach((element, i) => {
    var include = true;
    for ( var key in filters ) {
      switch (filters[key].filter) {
        case 'attribute':
          if ( filters[key].type == 'list' ) {
            if ( active_filters[key].length > 0 ) {
              let match = false;
              active_filters[key].
              map( x => filters[key].values[x]).
              forEach((item) => {
                if ( element[item] == "TRUE") {
                  match = true;
                  return;
                }
              });
              if ( !match ) {
                include = false;
                return;
              }
            }
          }
          else {
            if ( active_filters[key] ) {
              if ( element[filters[key].field] != "TRUE" ) {
                include = false;
                return;
              }
            }
          }
          break;
        case 'include':
          if ( active_filters[key].length > 0 ) {
            if ( !active_filters[key].map( x => filters[key].values[x]).includes(element[filters[key].field]) ) {
              include = false;
              return;
            }
          }
          break;
        case 'between':
          if ( active_filters[key] >= 0 ) {
            if ( element[filters[key].field[0]] > active_filters[key] || active_filters[key] > element[filters[key].field[1]] ) {
              include = false;
              return;
            }
          }
          break;
        case 'search':
          if ( active_filters[key] != '' ) {
            if ( Object.values(element).join(" ").toLowerCase().search(active_filters[key].toLowerCase()) === -1 ) {
              include = false;
              return;
            }
          }
        default:
          break;
      }
    }
    if (include) {
      result.push(element);
    }
  });
 render_filter_tags();
 renderElements(result);
}

function render_filter_tags() {
  console.log(active_filters);
  Object.keys(active_filters).forEach( indx => {
    console.log(indx, active_filters[indx]);
  });
  
}
//Single element html
function elementListHtml(element, i) {
  const style = get_style(element.poblacion);
  return '<li onclick="toggleDesc('+ i +')" class="srv" id="srv-'+ i +'">\
     <div class="srv-header"><h2>'+element.NOMBRE+'</h2><i style="color: '+style.color+'" class="fas fa-'+style.icon+'"></i></div>\
     <div class="srv-body">\
       <div class="row"><h3>'+element.pub_priv_sc+' - '+element.tipo_centro+'</h3></div>\
       <div class="row"><i class="fas fa-location-dot"></i><span>'+element.NOM_CAL+', '+element.NUM_PUE+'</span></div>\
       <div class="row"><i class="fas fa-phone"></i><span>'+element.TELEFON+'</span></div>\
       <div class="row"><i class="fas fa-link"></i><span>'+element.PAG_RED+'</span></div>\
       <div class="row"><i class="fas fa-envelope"></i><span>'+element.CORREO+'</span></div>\
       <div class="row"><i class="fas fa-users"></i><span>'+element.POB_OBJ+'</span></div>\
       <div class="row"><p>'+element.SERV_PR+'</p></div>\
       <div class="row"><p>'+element.info+'</p></div>\
  </li>';
 }
 function get_style(element) {
   var res = {color: '#15BE5A', icon: 'person'};
   switch (element) {
     case 'Niños y niñas':
        res = {color: '#15BE5A', icon: 'child'};
        break;
      case 'Personas adultas mayores':
        res = {color: '#3E189B', icon: 'person-cane'};
        break;
      case 'Personas en situación de discapacidad intelectual':
        res = {color: '#FF702C', icon: 'brain'};
        break;
      case 'Personas con discapacidad':
      case 'Personas en situación de discapacidad':
        res = {color: '#FF702C', icon: 'wheelchair'};
        break;
      case 'Personas en situación de discapacidad visual':
        res = {color: '#FF702C', icon: 'person-walking-with-cane'};
        break;
      case 'Personas con dificultades en el aprendizaje':
        res = {color: '#FF702C', icon: 'book-open'};
        break;
    }
    return res;
 }
 function renderElements(elements, initial = false) {
   //Generate markers for all data rows |element = data[0]
   if ( elements.length > 0 ) {
     markers.clearLayers();
     jQuery('#no-results').hide();
     currentList = elements;
     var list = '<ul>';
     elements.forEach((element, i) => {
       list += elementListHtml(element, i);
       var iconUrl = '/icon-green.png';
       switch (element.poblacion) {
         case 'Personas adultas mayores':
         iconUrl = '/icon-blue.png';
         break;
         case 'Personas con discapacidad':
         case 'Personas en situación de discapacidad':
         case 'Personas en situación de discapacidad visual':
         case 'Personas en situación de discapacidad intelectual':
         case 'Personas con dificultades en el aprendizaje':
         iconUrl = '/icon-orange.png';
         break;
       }
       var iconDefault = L.icon({
         className: "marker",
         iconUrl: iconUrl,
         iconSize: [29, 37],
         iconAnchor: [12, 37],
         popupAnchor: [1, -34],
         tooltipAnchor: [16, -28],
         shadowSize: [41, 41]
       });
       var mark = L.marker([element['lat'],element['lng']], {icon: iconDefault, list_pos: i}).on('click', clickPin).addTo(markers);
       mapBounds.push([element.lat, element.lng]);
       //Load filters lists if initial load
       if ( initial ) {
        filters_type('list').forEach( filter_list => {
          if ( !filter_list.values.includes(element[filter_list.field]) ) {
            filter_list.values.push(element[filter_list.field]);
          }
        });
       }
     });
     list += '</ul>';
     map.addLayer(markers);
     document.getElementById("list").innerHTML = list;
     document.getElementById("results").innerHTML = "Mostrando "+elements.length+"/"+window.total+" puntos";
     map.flyToBounds(mapBounds);
   }
   else {
     jQuery('#no-results').show();
   }
 }
</script>
